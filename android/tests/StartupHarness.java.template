import java.util.*;

/** Test doubles represent only the API surfaces called by extracted startup logic. */
public final class StartupHarness {
    static final String HOME = "https://xuexi.yinchao1204.vip/";
    static void expect(boolean value, String reason) { if (!value) throw new AssertionError(reason); }
    static void test(String name, Runnable body) { body.run(); System.out.println("PASS\t" + name); }
    static MainActivity app() { return new MainActivity(); }
    static void start(MainActivity app, String url) { app.webView.url = url; app.client.onPageStarted(app.webView, url, null); }
    static void finish(MainActivity app) { app.client.onPageFinished(app.webView, app.loadingUrl); }
    static void visible(MainActivity app) { expect(!app.loadFailed && app.webView.visibility == View.VISIBLE && app.errorView.visibility == View.GONE, "healthy page must remain visible"); }
    static void failed(MainActivity app) { expect(app.loadFailed && app.webView.visibility == View.GONE && app.errorView.visibility == View.VISIBLE, "failure must be visible with WebView hidden"); }

    public static void main(String[] args) {
        test("Main-document network and HTTP failures display useful diagnostics", () -> {
            MainActivity a = app(); start(a, HOME);
            a.client.onReceivedError(a.webView, new WebResourceRequest(HOME, true), new WebResourceError(-2));
            failed(a); expect(a.errorBody.text.contains("无法解析"), "DNS error category");
            a.loadPage(HOME); a.client.onReceivedHttpError(a.webView, new WebResourceRequest(HOME, true), new WebResourceResponse(503));
            failed(a); expect(a.errorBody.text.contains("503"), "HTTP status must be visible");
        });
        test("Network, HTTP and TLS subresource errors do not hide a healthy document", () -> {
            MainActivity a = app(); start(a, HOME);
            a.client.onReceivedError(a.webView, new WebResourceRequest(HOME + "asset.js", false), new WebResourceError(-2));
            a.client.onReceivedError(a.webView, -2, "failed", HOME + "image.png");
            a.client.onReceivedHttpError(a.webView, new WebResourceRequest(HOME + "image.png", false), new WebResourceResponse(500));
            SslErrorHandler tls = new SslErrorHandler();
            a.client.onReceivedSslError(a.webView, tls, new SslError("https://third-party.invalid/image.png", 3));
            expect(tls.cancelled && !tls.proceeded, "subresource TLS must be refused"); visible(a);
        });
        test("Main-document TLS errors are refused and display a certificate diagnostic", () -> {
            MainActivity a = app(); start(a, HOME); SslErrorHandler tls = new SslErrorHandler();
            a.client.onReceivedSslError(a.webView, tls, new SslError(HOME, SslError.SSL_IDMISMATCH));
            expect(tls.cancelled && !tls.proceeded, "TLS must never proceed"); failed(a);
            expect(a.errorBody.text.contains("不匹配"), "certificate mismatch is readable");
        });
        test("Rendered DOM readiness cancels the deadline and preserves the page", () -> {
            MainActivity a = app(); start(a, HOME); finish(a); a.loadHandler.advance(600);
            expect(a.pageReady, "DOM content must become ready");
            a.loadHandler.advance(31000); visible(a);
        });
        test("HTTP completion with an empty DOM eventually offers recovery", () -> {
            MainActivity a = app(); a.webView.result = "\"empty\""; start(a, HOME); finish(a);
            a.loadHandler.advance(8200); failed(a);
            expect(a.errorBody.text.contains("仍没有显示内容"), "blank page diagnostic");
        });
        test("Missing completion hits the bounded loading timeout", () -> {
            MainActivity a = app(); start(a, HOME); a.loadHandler.advance(29999); visible(a);
            a.loadHandler.advance(1); failed(a); expect(a.errorBody.text.contains("30 秒"), "timeout text");
        });
        test("Retry succeeds and stale timeouts cannot hide its result", () -> {
            MainActivity a = app(); start(a, HOME); Runnable oldDeadline = a.loadTimeout;
            a.loadHandler.advance(30000); failed(a);
            a.loadPage(HOME + "?view=ai"); finish(a); a.loadHandler.advance(600);
            oldDeadline.run(); visible(a); expect(a.pageReady, "retry renders");
        });
        test("A stale evaluateJavascript reply cannot change a newer load", () -> {
            MainActivity a = app(); a.webView.holdEvaluation = true; start(a, HOME); finish(a); a.loadHandler.advance(600);
            ValueCallback<String> oldReply = a.webView.pending.get(0);
            a.webView.holdEvaluation = false; a.loadPage(HOME + "?view=tasks"); finish(a); a.loadHandler.advance(600);
            oldReply.onReceiveValue("\"empty\""); a.loadHandler.advance(31000); visible(a); expect(a.pageReady, "new page remains ready");
        });
        test("Late errors from a prior document cannot replace the new page", () -> {
            MainActivity a = app(); String oldUrl = HOME + "?view=old", newUrl = HOME + "?view=ai";
            start(a, oldUrl); a.beginLoading(newUrl); // WebView.getUrl may still report its old document during navigation.
            a.client.onReceivedError(a.webView, new WebResourceRequest(oldUrl, true), new WebResourceError(-2));
            a.client.onReceivedHttpError(a.webView, new WebResourceRequest(oldUrl, true), new WebResourceResponse(500));
            SslErrorHandler tls = new SslErrorHandler(); a.client.onReceivedSslError(a.webView, tls, new SslError(oldUrl, 3));
            visible(a); expect(tls.cancelled, "late TLS still cancelled");
        });
        test("Initialization failure tolerates retry, back, save, pause and destroy", () -> {
            MainActivity a = app(); a.webView = null; a.downloads = null; a.initializationFailed = true;
            a.showError("初始化失败", "组件不可用", "组件初始化");
            a.loadPage(HOME); expect(a.recreates == 1, "retry recreates initialization");
            a.onBackPressed(); a.onSaveInstanceState(new Bundle()); a.onPause(); a.onDestroy();
            expect(a.parentBacks == 1 && a.parentSaves == 1 && a.parentPauses == 1 && a.parentDestroys == 1, "lifecycle delegates safely");
        });
        test("Destroy cancels scheduled work and ignores outstanding DOM replies", () -> {
            MainActivity a = app(); a.webView.holdEvaluation = true; start(a, HOME); finish(a); a.loadHandler.advance(600);
            ValueCallback<String> reply = a.webView.pending.get(0); a.onDestroy(); reply.onReceiveValue("\"empty\""); a.loadHandler.advance(40000);
            expect(a.destroyed && a.webView == null && !a.loadFailed, "destroyed activity cannot receive new UI failure");
        });
        test("Upgrade rejects saved IP history and restores only the configured origin", () -> {
            MainActivity old = app(); Bundle previous = new Bundle(); previous.putString("current_url", "https://154.40.47.111:3063/?view=ai"); previous.putBundle("web_state", new Bundle());
            old.restore(previous); expect(old.webView.restores == 0 && HOME.equals(old.webView.url), "old origin must be discarded");
            MainActivity current = app(); Bundle state = new Bundle(); state.putString("current_url", HOME + "?view=tasks"); state.putBundle("web_state", new Bundle());
            current.webView.restorationWorks = true; current.restore(state); expect(current.webView.restores == 1 && current.webView.loads == 0, "current origin history restores");
            MainActivity missing = app(); missing.restore(new Bundle()); expect(HOME.equals(missing.webView.url), "missing state loads canonical origin");
        });
        test("Retry and system browser buttons use the configured canonical HTTPS origin", () -> {
            MainActivity a = app(); LinearLayout errors = a.createErrorView();
            Button retry = (Button) errors.children.get(2), browser = (Button) errors.children.get(3);
            retry.click(); expect(HOME.equals(a.webView.url), "retry canonical URL");
            browser.click(); expect(a.launched != null && HOME.equals(a.launched.uri.toString()), "browser canonical URL");
        });
        test("Diagnostic display omits URL query, fragment and user information", () -> {
            MainActivity a = app(); start(a, "https://user:password@xuexi.yinchao1204.vip/path?secret=private#token");
            a.showError("连接失败", "无法连接", "测试");
            expect(a.errorBody.text.contains("https://xuexi.yinchao1204.vip"), "diagnostic origin");
            for (String secret : new String[]{"password", "private", "token", "/path", "user:"}) expect(!a.errorBody.text.contains(secret), "diagnostics must omit " + secret);
        });
        test("A synchronous WebView load failure displays recovery instead of escaping", () -> {
            MainActivity a = app(); a.webView.failLoad = true; a.loadPage(HOME); failed(a);
            expect(a.errorBody.text.contains("未能开始加载"), "load exception diagnostic");
        });
    }

