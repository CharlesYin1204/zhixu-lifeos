    static class Build { static class VERSION { static final String RELEASE = "16-fixture"; } }
    static class Handler {
        long now, order; List<Job> jobs = new ArrayList<>();
        static class Job { Runnable action; long due, sequence; Job(Runnable r,long d,long s) { action=r; due=d; sequence=s; } }
        boolean postDelayed(Runnable r,long delay) { jobs.add(new Job(r, now+delay, ++order)); return true; }
        void removeCallbacks(Runnable r) { jobs.removeIf(j -> j.action == r); }
        void removeCallbacksAndMessages(Object token) { jobs.clear(); }
        void advance(long millis) {
            long until=now+millis; int guard=0;
            while(true) { Job next=jobs.stream().filter(j -> j.due<=until).min(Comparator.comparingLong((Job j)->j.due).thenComparingLong(j->j.sequence)).orElse(null); if(next==null)break; if(++guard>1000)throw new AssertionError("runaway scheduled work"); jobs.remove(next); now=next.due; next.action.run(); }
            now=until;
        }
    }
    interface ValueCallback<T> { void onReceiveValue(T value); }
    static class WebView extends View {
        String url = HOME, result = "\"content\""; boolean holdEvaluation, failLoad, restorationWorks; int loads, restores;
        List<ValueCallback<String>> pending = new ArrayList<>();
        String getUrl() { return url; }
        void loadUrl(String value) { loads++; if(failLoad)throw new RuntimeException("fixture failure"); url=value; }
        void evaluateJavascript(String script,ValueCallback<String> callback) { if(holdEvaluation)pending.add(callback);else callback.onReceiveValue(result); }
        void stopLoading() {} boolean canGoBack() { return false; } void goBack() {} void saveState(Bundle state) {} Object restoreState(Bundle state) { restores++; return restorationWorks ? state : null; }
        Object getParent() { return null; } void destroy() {}
    }
