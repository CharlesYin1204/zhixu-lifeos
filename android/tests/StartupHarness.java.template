    }
    static class Uri {
        java.net.URI value; Uri(String raw) { value=java.net.URI.create(raw); }
        static Uri parse(String value) { return new Uri(value); }
        String getScheme(){return value.getScheme();} String getHost(){return value.getHost();} int getPort(){return value.getPort();} String getPath(){return value.getPath();}
        String getQueryParameter(String name) { String query=value.getQuery(); if(query==null)return null; for(String pair:query.split("&")){String[] kv=pair.split("=",2);if(kv[0].equals(name))return kv.length==2?kv[1]:"";} return null; }
        Builder buildUpon(){return new Builder(value.toString());} public String toString(){return value.toString();}
        static class Builder { String value; Builder(String raw){value=raw;} Builder fragment(String fragment){int hash=value.indexOf('#');if(hash>=0)value=value.substring(0,hash);if(fragment!=null)value+="#"+fragment;return this;} Uri build(){return new Uri(value);} }
    }
